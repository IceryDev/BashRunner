<?xml version="1.0" encoding="UTF-8"?>
<kcfg>
  <group name="General">
    <entry name="filePath" type="Path">
      <label>File path for bash scripts.</label>
    </entry>
    <entry name="trigger" type="String">
      <label>Trigger prefix for the runner.</label>
      <default>/sh </default>
    </entry>
  </group>
</kcfg>